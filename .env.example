# Copy this file to ".env" and fill in what you have. Anything left blank
# degrades gracefully — the matching tile shows an actionable CTA instead.

# ---- Config (safe, non-secret) ----
YOUTUBE_HANDLE=@yourhandle
INSTAGRAM_USERNAME=yourusername
TIKTOK_USERNAME=yourusername
PORT=3000

# Folder the embedded Claude terminal runs in (so your skills + CLAUDE.md load).
AIOS_CLAUDE_CWD=

# Optional overrides:
AIOS_CLAUDE_BIN=
PROJECTS_FILE=
CONTENT_INTEL_FILE=

# ---- Secrets (never commit a real .env) ----
# YouTube Data API v3 key — https://console.cloud.google.com → enable "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=
# Apify token — https://console.apify.com/account/integrations  (free tier ~$5/mo credit)
APIFY_API_TOKEN=

# ---- Nextdoor lead capture (optional) ----
# A dedicated Gmail inbox that all your Nextdoor email is sent to. The dashboard
# reads it over IMAP, keeps only posts about detailing/car-wash, and feeds them
# into the Local Demand tile. Use a Gmail APP PASSWORD (needs 2-Step Verification
# on that account): https://myaccount.google.com/apppasswords
NEXTDOOR_IMAP_USER=
NEXTDOOR_IMAP_PASS=
# Optional: override the keyword filter (comma-separated) or the mailbox/label.
NEXTDOOR_KEYWORDS=
NEXTDOOR_MAILBOX=INBOX

META_LEADS_SHEET_URL=

# JARVIS uses the existing Codex login with a separate conversation and config.
JARVIS_CODEX_MODEL=gpt-5.6-luna
JARVIS_CODEX_REASONING=low
JARVIS_CODEX_TIMEOUT_MS=45000
# Web research uses the same Codex account. Set disabled to turn it off.
JARVIS_WEB_SEARCH=live
# Optional capability paths (defaults shown; user data lives outside the repo).
JARVIS_PROJECTS_ROOT=C:/Dev
# JARVIS_ROUTINES_FILE=
# JARVIS_NOTES_ROOT=
# JARVIS_EDIT_BACKUPS=
# Speech generation keeps the configured ElevenLabs voice; Flash reduces latency.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_TIMEOUT_MS=5000
